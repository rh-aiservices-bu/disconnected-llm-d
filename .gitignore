# Your environment's settings. Holds no secrets itself, but names the hosts and
# points at the disconnected-rhoai checkout whose config does.
config/llmd.env
config/llmd.env.resolved

# Generated by scripts/05-discover-images.sh from a live cluster. Cluster- and
# RHOAI-version-specific, and it records the cluster's API URL — regenerate it,
# do not commit it.
config/required-images.txt

# Generated by scripts/remote.sh. Contains host addresses and the path to your
# SSH key.
.ssh-config

# Throwaway registry auth written by scripts/lib/common.sh:mirror_login
.llmd-auth.json

# oc-mirror scratch
working/

*.log
.claude/settings.json
