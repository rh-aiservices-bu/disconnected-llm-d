# llm-d on a disconnected RHOAI cluster — configuration.
#
#   cp config/llmd.env.example config/llmd.env
#
# Only the values under "you must set" normally need touching. Everything else
# has a default that matches the CRIAB lab.
#
# Host, registry and credential values are NOT duplicated here — they are read
# from CRIAB's config/criab.env (see CRIAB_ENV below). Keeping one source of
# truth for MIRROR_REGISTRY and the SSH targets avoids the two files drifting
# apart, which is how you end up pushing to a registry the cluster does not
# trust.

# ---------------------------------------------------------------------------
# you must set
# ---------------------------------------------------------------------------

# Where the CRIAB repo lives. On your laptop this is the local checkout; on the
# lab hosts it is ~/criab. Its config/criab.env supplies MIRROR_REGISTRY,
# MIRROR_REGISTRY_USER/PASSWORD, LOW_SIDE_HOST, HIGH_SIDE_HOST and friends.
CRIAB_DIR="${CRIAB_DIR:-${HOME}/projects/criab}"

# ---------------------------------------------------------------------------
# model
# ---------------------------------------------------------------------------

# Which manifest overlay to deploy: qwen3-4b or qwen2.5-0.5b.
#
#   qwen2.5-0.5b   0.9 GiB image, 1 GPU  — use this first, it proves the whole
#                                          path (mirror -> modelcar -> vLLM ->
#                                          scheduler -> gateway) in minutes
#   qwen3-4b       7.6 GiB image, 1 GPU/replica — the demo model
LLMD_MODEL="${LLMD_MODEL:-qwen2.5-0.5b}"

# ModelCar images, digest-pinned. These are the ONLY images this project adds
# to the mirror — everything else llm-d needs (vLLM runtime, EPP/scheduler,
# storage initializer) ships in the RHOAI operator bundle and is already there.
#
# Digests resolved 2026-08-12 from quay.io/redhat-ai-services/modelcar-catalog.
# Re-resolve with: scripts/10-stage-images.sh --resolve
MODELCAR_QWEN25_05B="${MODELCAR_QWEN25_05B:-quay.io/redhat-ai-services/modelcar-catalog@sha256:e20441c23be795838409137576b9016e6bc941eec79e5765cf9de6319c0ec769}"
MODELCAR_QWEN3_4B="${MODELCAR_QWEN3_4B:-quay.io/redhat-ai-services/modelcar-catalog@sha256:2252a63e6f0f36df27ace6497330dfba61b7501024cf44fa67480d3848471809}"

# Tags the digests above correspond to. Used only by --resolve to re-pin.
MODELCAR_QWEN25_05B_TAG="${MODELCAR_QWEN25_05B_TAG:-qwen2.5-0.5b-instruct}"
MODELCAR_QWEN3_4B_TAG="${MODELCAR_QWEN3_4B_TAG:-qwen3-4b}"

# ---------------------------------------------------------------------------
# deployment
# ---------------------------------------------------------------------------

LLMD_NAMESPACE="${LLMD_NAMESPACE:-demo-llm}"

# Replicas of the decode/vLLM pod. One GPU each. The CRIAB worker set has no
# GPU until a MachineSet is added; g5.12xlarge gives 4, g5.2xlarge gives 1.
# Leave empty to use whatever the overlay ships with.
LLMD_REPLICAS="${LLMD_REPLICAS:-1}"

# Create the GatewayClass and Gateway. Set false if the cluster already has a
# Gateway you want llm-d to attach to — see LLMD_GATEWAY_NAME.
LLMD_MANAGE_GATEWAY="${LLMD_MANAGE_GATEWAY:-true}"
# Red Hat's llm-d prerequisites name this Gateway specifically: a Gateway called
# openshift-ai-inference in openshift-ingress. Keep the name unless you have a
# reason.
LLMD_GATEWAY_NAME="${LLMD_GATEWAY_NAME:-openshift-ai-inference}"
LLMD_GATEWAY_NAMESPACE="${LLMD_GATEWAY_NAMESPACE:-openshift-ingress}"
LLMD_GATEWAY_CLASS="${LLMD_GATEWAY_CLASS:-openshift-default}"

# On AWS the gateway Service defaults to an EXTERNAL NLB with public IPs, which
# nothing in a disconnected VPC can reach — not the high side, not pods
# resolving the gateway hostname. "auto" patches it to an internal NLB when the
# platform is AWS. Set false to leave the Service alone.
LLMD_GATEWAY_INTERNAL_LB="${LLMD_GATEWAY_INTERNAL_LB:-auto}"

# Apply the gpu-profile HardwareProfile. Purely a dashboard convenience; the
# LLMInferenceService annotations reference it.
LLMD_MANAGE_HARDWARE_PROFILE="${LLMD_MANAGE_HARDWARE_PROFILE:-true}"

# ---------------------------------------------------------------------------
# GPU node (scripts/12-gpu-machineset.sh)
# ---------------------------------------------------------------------------

# L40S on AWS is the g6e family. 48 GB VRAM per GPU.
#
#   g6e.2xlarge    1x L40S    8 vCPU   64 GiB   <- default, ~$2/hr
#   g6e.12xlarge   4x L40S   48 vCPU  384 GiB   <- for 4 llm-d replicas
#
# g6e is not offered in every AZ; the script checks before applying. If it is
# unavailable, g5.2xlarge (1x A10G, 24 GB) is the fallback that is nearly
# always present.
GPU_INSTANCE_TYPE="${GPU_INSTANCE_TYPE:-g6e.2xlarge}"
GPU_REPLICAS="${GPU_REPLICAS:-1}"

# Red Hat's floor is 50 GB per GPU node for images and ephemeral storage. The
# vLLM CUDA image plus a 7.6 GiB ModelCar clears that on its own, so 200 leaves
# room for a second model without a resize.
GPU_VOLUME_SIZE="${GPU_VOLUME_SIZE:-200}"

# Taint the GPU node with nvidia.com/gpu:NoSchedule. Default OFF: a taint keeps
# cheap workloads off an expensive node, but every DaemonSet that must run
# there (NFD worker, NVIDIA driver, device plugin) has to tolerate it, and when
# one does not the symptom is a GPU node with no capacity — which looks exactly
# like a driver failure. Turn it on after the GPU stack is confirmed working.
GPU_TAINT="${GPU_TAINT:-false}"

# Set false to skip the interactive "type the instance type" confirmation.
GPU_CONFIRM="${GPU_CONFIRM:-true}"

# Name for the MachineSet. Defaults to <infra-id>-gpu-<az>.
GPU_MACHINESET_NAME="${GPU_MACHINESET_NAME:-}"

# CUDA development packages the NVIDIA driver container compiles against.
# Must match what the driver expects — read it off the ClusterPolicy or the
# driver pod log; scripts/14-gpu-driver-disconnected.sh diagnose prints how.
CUDA_VERSION="${CUDA_VERSION:-12-6}"

# Base image for the in-cluster kernel/CUDA package repo. MUST be mirrored —
# it is listed in config/additional-images.txt for exactly that reason.
KERNEL_REPO_BASE_IMAGE="${KERNEL_REPO_BASE_IMAGE:-registry.access.redhat.com/ubi9/httpd-24:latest}"

# ---------------------------------------------------------------------------
# behaviour
# ---------------------------------------------------------------------------

# Namespace holding the KServe inferenceservice-config ConfigMap. RHOAI puts it
# in redhat-ods-applications; upstream KServe uses kserve.
KSERVE_NAMESPACE="${KSERVE_NAMESPACE:-redhat-ods-applications}"

# How long to wait for pods to come up. A 7.6 GiB ModelCar pull on a cold node
# is slow — the image has to come off Quay on the high side before the pod can
# start, and that is a one-time cost per node.
WAIT_TIMEOUT="${WAIT_TIMEOUT:-1800}"

# Log destination on the lab hosts. /mnt/mirror, never $HOME — filling / takes
# the host off the network entirely.
LLMD_LOG_DIR="${LLMD_LOG_DIR:-/mnt/mirror}"

# Path to CRIAB's env file, derived from CRIAB_DIR. Override only if you keep
# it somewhere unusual.
CRIAB_ENV="${CRIAB_ENV:-${CRIAB_DIR}/config/criab.env}"

# Set true to print what would run without changing anything.
DRY_RUN="${DRY_RUN:-false}"
